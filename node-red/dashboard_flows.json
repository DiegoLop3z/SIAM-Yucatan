    {
        "id": "fn_formato_fan",
        "type": "function",
        "z": "tab_bioclima_siam",
        "name": "Formato Texto Ventilador",
        "func": "const est = String(msg.payload).trim().toUpperCase();\nif (est === 'ON') {\n    msg.payload = '🌀 EN REVOLUCIÓN (Transistor Saturado / Extracción Activa)';\n} else {\n    msg.payload = '⏹ DETENIDO (Transistor en Corte)';\n}\nreturn msg;",
        "outputs": 1,
        "x": 490,
        "y": 570,
        "wires": [
