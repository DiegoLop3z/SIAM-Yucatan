    {
        "id": "fn_formato_modo",
        "type": "function",
        "z": "tab_bioclima_siam",
        "name": "Formato Modo y Timer",
        "func": "const m = String(msg.payload).trim().toUpperCase();\nif (m === 'MANUAL') {\n    msg.payload = '⚙️ MANUAL (Purga iniciada: auto-retorno a AUTO en 60s)';\n} else {\n    msg.payload = '🤖 AUTOMÁTICO (Mitigación por calor + presencia)';\n}\nreturn msg;",
        "outputs": 1,
        "x": 480,
        "y": 680,
        "wires": [
