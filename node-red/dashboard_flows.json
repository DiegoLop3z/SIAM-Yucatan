    {
        "id": "fn_presencia_ui",
        "type": "function",
        "z": "tab_bioclima_siam",
        "name": "Formato Presencia",
        "func": "const pres = String(msg.payload).trim();\nif (pres === '1') {\n    msg.payload = '🚶 PRESENCIA DETECTADA';\n    msg.color = '#2ec27e';\n} else {\n    msg.payload = '⚪ ESPACIO DESPEJADO';\n    msg.color = '#777777';\n}\nreturn msg;",
        "outputs": 1,
        "x": 440,
        "y": 340,
        "wires": [
            [
                "txt_presencia"
            ]
        ]
    },
