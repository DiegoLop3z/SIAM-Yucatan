    {
        "id": "fn_evaluar_alerta",
        "type": "function",
        "z": "tab_bioclima_siam",
        "name": "Evaluar NOM-015 Semáforo",
        "func": "const hi = parseFloat(msg.payload);\nif (hi < 30.0) {\n    msg.payload = '🟢 CONFORT TÉRMICO (Trabajo seguro)';\n} else if (hi < 38.0) {\n    msg.payload = '🟡 PRECAUCIÓN (Fatiga térmica / Hidratación requerida)';\n} else {\n    msg.payload = '🔴 PELIGRO CRÍTICO: RIESGO DE GOLPE DE CALOR';\n}\nreturn msg;",
        "outputs": 1,
        "x": 480,
        "y": 390,
        "wires": [
            [
                "txt_alerta_semaforo"
            ]
        ]
    },
