#ifndef SECRETS_H
#define SECRETS_H

// ============================================================================
//  Credenciales de Red y Mosquitto Broker (Ejemplo)
//  Copie este archivo como 'secrets.h' en este mismo directorio (include/)
//  y rellene sus propios valores. secrets.h NUNCA debe subirse al repositorio.
//  Valores por defecto: hotspot de la laptop (NetworkManager, IP fija
//  10.42.0.1) y Mosquitto con autenticación + ACL.
// ============================================================================

#define WIFI_SSID           "nombre_de_tu_hotspot"
#define WIFI_PASSWORD       "contrasena_del_hotspot"

#define MQTT_SERVER         "10.42.0.1"   // IP fija del hotspot de la laptop que ejecuta Mosquitto
#define MQTT_PORT           1883
#define MQTT_USER           "esp32_user"
#define MQTT_PASSWORD       "contrasena_mqtt"

#endif // SECRETS_H
